ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Choose at most one remote embedding provider. Gemini uses the existing GEMINI_API_KEY.
USE_OPENAI_EMBEDDINGS=false
USE_GEMINI_EMBEDDINGS=true
OPENAI_API_KEY=your_openai_api_key_here

# Claude model to use (claude-3-5-sonnet-20241022 is recommended)
CLAUDE_MODEL=
# Optional local multilingual model (Hindi + English). Install
# requirements-local-embeddings.txt before disabling both remote providers.
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Storage paths (relative to rag_service/)
FAISS_INDEX_DIR=./faiss_indexes
UPLOAD_DIR=./uploaded_files

# Chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
GEMINI_MODEL=gemini-3.8-flash

# How many chunks to retrieve per query
TOP_K_CHUNKS=5

# Max upload file size in MB
MAX_FILE_SIZE_MB=20

# Shared secret reserved for backend<->rag_service auth (generate a random value)
INTERNAL_API_KEY=
# Internal docker-compose service name, not localhost
# (local dev without Docker: http://localhost:5000)
MASTER_BACKEND_URL=http://backend:5000
ENVIRONMENT=production
PORT=8000
